{
  "name": "alpha-terminal",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b && tsc -p apps/api/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "dev:api": "wrangler dev --config apps/api/wrangler.toml",
    "dev:pages": "npm run build && wrangler pages dev dist",
    "deploy:api": "wrangler deploy --config apps/api/wrangler.toml",
    "dev:worker": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "lightweight-charts": "^5.0.8",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
