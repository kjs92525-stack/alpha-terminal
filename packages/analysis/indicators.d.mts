import type { Bar, Num, Swing, StructureEvent, FVG, OrderBlock, VolumeProfile, Level, Regime, Analysis } from './types';
export function sma(values: number[], period: number): Num[];
export function ema(values: number[], period: number): Num[];
export function rsi(closes: number[], period?: number): Num[];
export function macd(closes: number[], fast?: number, slow?: number, signal?: number): { macd: Num[]; signal: Num[]; hist: Num[] };
export function trueRange(bars: Bar[]): number[];
export function atr(bars: Bar[], period?: number): Num[];
export function easternDayKey(unixSeconds: number): string;
export function vwap(bars: Bar[], anchor?: 'session' | 'none'): Num[];
export function obv(bars: Bar[]): number[];
export function swings(bars: Bar[], left?: number, right?: number): Swing[];
export function marketStructure(bars: Bar[], opts?: { left?: number; right?: number; lastBarClosed?: boolean }): Analysis['structure'];
export function fairValueGaps(bars: Bar[], opts?: { lastBarClosed?: boolean; minGapPct?: number }): FVG[];
export function orderBlocks(bars: Bar[], events: StructureEvent[]): OrderBlock[];
export function volumeProfile(bars: Bar[], binCount?: number, valueAreaPct?: number): VolumeProfile;
export function supportResistance(bars: Bar[], opts?: { left?: number; right?: number; tolerance?: number; maxLevels?: number }): Level[];
export function trendRegime(closes: number[]): Regime;
export function resampleWeekly(bars: Bar[]): Bar[];
export function analyzeBars(bars: Bar[], opts?: { lastBarClosed?: boolean; vwapAnchor?: 'session' | 'none' }): Analysis;
