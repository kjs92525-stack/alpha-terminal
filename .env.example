# ---- Web app (build-time, PUBLIC — never put secrets in VITE_*) ----
# Leave empty when the API is served by Pages Functions on the same origin (/api/*).
VITE_API_BASE_URL=
# auto | live | mock   (auto: live if /api/v1/health answers, otherwise simulated data)
VITE_DATA_MODE=auto
# Nightly snapshot location (default: this repo's public data branch on raw.githubusercontent.com)
VITE_SNAPSHOT_BASE_URL=
# Optional Supabase (anon key is public by design; RLS protects data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- API (Cloudflare secrets / vars; local dev: put in .dev.vars) ----
# Required for SEC EDGAR fair access: "AppName/version contact@email"
SEC_USER_AGENT=
# Comma list in priority order: stooq,yahoo (yahoo also enables 5m/1H bars)
PRICE_PROVIDERS=stooq,yahoo
# Max symbols per /screen call (Cloudflare free plan: keep <= 5)
SCREEN_MAX=5
ALLOWED_ORIGIN=*

# ---- TradingView webhook (Cloudflare secrets) ----
# Long random string; also typed into the TradingView alert message / ALPHA STRUCT indicator input
TV_WEBHOOK_SECRET=
# Optional Telegram forwarding (create a bot with @BotFather, get chat id via getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Alpaca (Cloudflare Pages secrets for news/movers/prices AND GitHub Actions secrets for the nightly pipeline) ----
# Free Alpaca account -> API keys (paper keys work for market data)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# SEC_USER_AGENT is also required here (same value as above)
